# ── REQUIRED ────────────────────────────────────────────────────────────────

# Primary Gemini API key (get free at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_primary_gemini_api_key_here

# Add more keys to rotate when you hit the 15 RPM free-tier limit.
# Each key multiplies your effective rate limit. All must be Gemini API keys.
# GOOGLE_API_KEY_2=your_second_key_here
# GOOGLE_API_KEY_3=your_third_key_here

# JSearch API key (RapidAPI → JSearch)
JSEARCH_API_KEY=your_jsearch_api_key_here

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_long_random_secret

# ── OPTIONAL ─────────────────────────────────────────────────────────────────

# How many days JWT tokens stay valid (default: 7)
# ACCESS_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed frontend origins (default: localhost for dev)
# In production set this to your deployed frontend URL:
# ALLOWED_ORIGINS=https://careeros.vercel.app,https://www.careeros.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Path to SQLite database file.
# In production on Render: mount a persistent disk to /app/data and set this:
# DB_PATH=/app/data/checkpoints.db
# Leave unset for local dev (uses backend/checkpoints.db by default)

